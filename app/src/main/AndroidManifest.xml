<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Dibs makes no network calls (CLAUDE.md invariant 3). This line strips
        INTERNET from the merged manifest no matter which dependency asks for
        it: ML Kit pulls in Google's telemetry uploader
        (com.google.android.datatransport), whose manifest requests it. Without
        the permission the OS refuses every socket this process opens, so the
        uploader can never send anything. Text recognition itself is bundled
        and runs on the device. `verify*NoInternetPermission` (in `check`)
        fails the build if this stops working. Do not remove.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Only for FR-E7 recurring-expense reminders; requested at rule creation. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DibsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dibs">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- SPEC §5.9: dibs://join invite links (M6). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dibs" android:host="join" />
            </intent-filter>
            <!--
                FR-Y1: invite files (.dibsinvite) and update files (.dibssync) opened
                from a chat app or file manager. Chat apps strip custom MIME types, so
                Dibs has to offer itself for generic binary files and then check the
                file's first bytes itself; anything else gets "that isn't a Dibs file".
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.dibs.invite" />
                <data android:mimeType="application/vnd.dibs.sync" />
            </intent-filter>
            <!-- "Share to Dibs": a received file, or a message containing an invite link. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.dibs.invite" />
                <data android:mimeType="application/vnd.dibs.sync" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Sync bundles leave the device only through explicit shares (FR-Y1). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
